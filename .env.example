# Copy to .env.local for local dev. In production, set these in the Vercel
# project's Environment Variables settings instead — never commit real keys.

# PayPal — developer.paypal.com/dashboard/applications, Sandbox tab (use
# Sandbox until you're ready to go live, then repeat this with a Live app).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# "sandbox" or "live" — selects which PayPal API base URL the server calls.
PAYPAL_ENV=sandbox

# PayPal — same app's Webhooks section, after adding an endpoint pointing at
# https://www.healthyguide.online/api/webhooks/paypal subscribed to
# PAYMENT.CAPTURE.COMPLETED.
PAYPAL_WEBHOOK_ID=

# Order storage — add a Redis/KV store from the Vercel Storage tab
# (e.g. Upstash for Redis); it auto-populates these two on import, or the
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN equivalents.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional — email delivery of the access link on purchase (via resend.com).
# Checkout still works without these; the buyer just relies on the
# post-payment redirect instead of a backup email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
